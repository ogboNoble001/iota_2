{
        "rewrites": [
                { "source": "/", "destination": "/index.html" },
                { "source": "/index", "destination": "/index.html" },
                { "source": "/editor", "destination": "/editor/editor.html" }
        ],
        "redirects": [
                { "source": "/index.html", "destination": "/index", "permanent": true },
                { "source": "/editor/editor.html", "destination": "/editor", "permanent": true },
                { "source": "/editor.html", "destination": "/editor", "permanent": true }
        ]
}